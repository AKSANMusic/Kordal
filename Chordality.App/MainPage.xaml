<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Chordality_App.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Chordality_App"
    xmlns:vm="using:Chordality.App.ViewModels"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Background="#050508">
        <Grid.RowDefinitions>
            <!-- Top Section: Polymorphic Visualizers -->
            <RowDefinition Height="2*" />
            <!-- Middle Section: Circle of Fifths -->
            <RowDefinition Height="3*" />
            <!-- Bottom Section: Modifier Matrix -->
            <RowDefinition Height="1*" />
        </Grid.RowDefinitions>

        <!-- Top Section: Polymorphic Visualizers -->
        <Border Grid.Row="0" BorderBrush="#FF8000" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- View Switcher -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center" Margin="10">
                    <Button Content="Pad" Click="SetPadMode" Background="#1A1A24" Foreground="#FF8000" BorderBrush="#FF8000" BorderThickness="1" CornerRadius="4 0 0 4"/>
                    <Button Content="Blocks" Click="SetNoteBlockMode" Background="#1A1A24" Foreground="#FF8000" BorderBrush="#FF8000" BorderThickness="1,1,1,1" CornerRadius="0"/>
                    <Button Content="Piano" Click="SetPianoMode" Background="#1A1A24" Foreground="#FF8000" BorderBrush="#FF8000" BorderThickness="1,1,1,1" CornerRadius="0"/>
                    <Button Content="Guitar" Click="SetGuitarMode" Background="#1A1A24" Foreground="#FF8000" BorderBrush="#FF8000" BorderThickness="1" CornerRadius="0 4 4 0"/>
                </StackPanel>

                <!-- Mode: Pad -->
                <Grid Grid.Row="1" x:Name="PadViewContainer" Visibility="Visible">
                    <Border Background="#1A1A24" BorderBrush="#FF8000" BorderThickness="2" CornerRadius="8" Width="300" Height="150" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="{x:Bind ViewModel.ActiveChordName, Mode=OneWay}" Foreground="#FF8000" FontSize="48" FontWeight="Bold" HorizontalAlignment="Center"/>
                            <TextBlock Text="{x:Bind ViewModel.InversionDisplay, Mode=OneWay}" Foreground="#FF8000" FontSize="20" HorizontalAlignment="Center" Margin="0,10,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Mode: Note Blocks -->
                <Grid Grid.Row="1" x:Name="NoteBlockViewContainer" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <ItemsControl ItemsSource="{x:Bind ViewModel.NoteBlocks, Mode=OneWay}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="10"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <Border Background="#1A1A24" BorderBrush="#FF8000" BorderThickness="2" CornerRadius="4" Width="60" Height="100">
                                    <TextBlock Text="{x:Bind}" Foreground="#FF8000" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>

                <!-- Mode: Piano -->
                <Grid Grid.Row="1" x:Name="PianoViewContainer" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <!-- We will render the piano keys in code-behind to map them exactly -->
                    <Canvas x:Name="PianoCanvas" Width="600" Height="150" Background="Transparent"/>
                </Grid>

                <!-- Mode: Guitar -->
                <Grid Grid.Row="1" x:Name="GuitarViewContainer" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <!-- Fretboard drawn in code-behind -->
                    <Canvas x:Name="GuitarCanvas" Width="800" Height="180" Background="Transparent"/>
                </Grid>

            </Grid>
        </Border>

        <!-- Middle Section: Circle of Fifths -->
        <Border Grid.Row="1" BorderBrush="#00FF00" BorderThickness="0,0,0,1">
            <Grid>
                <!-- Radial Nodes Canvas -->
                <Canvas x:Name="CircleCanvas" HorizontalAlignment="Center" VerticalAlignment="Center"
                        PointerMoved="CircleCanvas_PointerMoved" PointerPressed="CircleCanvas_PointerPressed" Background="Transparent" Width="400" Height="400"/>

                <!-- Central Typography -->
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                    <TextBlock Text="{x:Bind ViewModel.ActiveChordName, Mode=OneWay}" Foreground="#00FF00" FontSize="48" FontFamily="Consolas" FontWeight="Bold" HorizontalAlignment="Center"/>
                    <TextBlock Text="{x:Bind ViewModel.ActiveNotesDisplay, Mode=OneWay}" Foreground="#00FF00" FontSize="16" FontFamily="Consolas" HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Bottom Section: Modifier Matrix -->
        <Border Grid.Row="2" Padding="20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- MIDI Settings Panel -->
                <StackPanel Grid.Column="0" Orientation="Vertical" Spacing="5" Background="#1A1A24" Padding="10" CornerRadius="4" BorderBrush="#FF8000" BorderThickness="1" Margin="0,0,20,0" VerticalAlignment="Center">
                    <TextBlock Text="MIDI HARDWARE" Foreground="#FF8000" FontSize="10" FontWeight="Bold"/>
                    <ToggleSwitch IsOn="{x:Bind ViewModel.IsMidiEnabled, Mode=TwoWay}" OffContent="Disabled" OnContent="Enabled" Foreground="White" MinWidth="0"/>
                    <ComboBox ItemsSource="{x:Bind ViewModel.MidiService.OutputDevices}"
                              SelectedItem="{x:Bind ViewModel.SelectedMidiDevice, Mode=TwoWay}"
                              DisplayMemberPath="Name"
                              PlaceholderText="Select Output..."
                              Width="150"
                              IsEnabled="{x:Bind ViewModel.IsMidiEnabled, Mode=OneWay}"/>

                    <!-- Phase 5 Stash Export -->
                    <TextBlock Text="STASH EXPORT" Foreground="#00FF00" FontSize="10" FontWeight="Bold" Margin="0,10,0,0"/>
                    <Button Content="Save Last 1 Min" Command="{x:Bind ViewModel.ExportStashCommand}" CommandParameter="1" Background="#00FF00" Foreground="Black" Width="150" Margin="0,2,0,0"/>
                    <Button Content="Save Last 20 Mins" Command="{x:Bind ViewModel.ExportStashCommand}" CommandParameter="20" Background="#00FF00" Foreground="Black" Width="150" Margin="0,2,0,0"/>
                </StackPanel>

                <!-- Modifiers Grid -->
                <GridView Grid.Column="1" ItemsSource="{x:Bind ViewModel.ModifierItems}" SelectionMode="None">
                    <GridView.ItemTemplate>
                        <DataTemplate x:DataType="vm:ModifierItem">
                            <ToggleButton Content="{x:Bind DisplayName}"
                                          IsChecked="{x:Bind IsActive, Mode=TwoWay}"
                                          Width="60" Height="40"
                                          Margin="4"
                                          Background="#1A1A24"
                                          Foreground="#00FF00"
                                          BorderBrush="#00FF00"
                                          BorderThickness="1"
                                          CornerRadius="4" />
                        </DataTemplate>
                    </GridView.ItemTemplate>
                </GridView>

                <!-- Sequencer & Inversion Controls -->
                <StackPanel Grid.Column="2" Orientation="Vertical" VerticalAlignment="Center" Margin="20,0,0,0" Spacing="10">

                    <!-- Sequencing Controls -->
                    <StackPanel Orientation="Vertical" Spacing="5" Background="#1A1A24" Padding="5" CornerRadius="4" BorderBrush="#00FF00" BorderThickness="1">
                        <TextBlock Text="PLAYBACK" Foreground="#00FF00" FontSize="10" HorizontalAlignment="Center" FontWeight="Bold"/>

                        <RadioButton Content="Chord" IsChecked="True" Foreground="White" Checked="SetPlaybackChord"/>
                        <RadioButton Content="Strum" Foreground="White" Checked="SetPlaybackStrum"/>
                        <RadioButton Content="Arp" Foreground="White" Checked="SetPlaybackArp"/>

                        <TextBlock Text="{x:Bind ViewModel.Bpm, Mode=OneWay}" Foreground="#00FF00" HorizontalAlignment="Center" FontSize="12" Margin="0,5,0,0"/>
                        <Slider Minimum="60" Maximum="240" Value="{x:Bind ViewModel.Bpm, Mode=TwoWay}" Width="80"/>
                    </StackPanel>

                    <!-- Inversion Controls -->
                    <StackPanel Orientation="Vertical">
                        <Button Content="▲" Command="{x:Bind ViewModel.InversionUpCommand}" Width="50" Height="30" Background="#1A1A24" Foreground="#FF8000" BorderBrush="#FF8000" BorderThickness="1" CornerRadius="4 4 0 0" HorizontalAlignment="Center"/>
                        <Button Content="0" Command="{x:Bind ViewModel.InversionRootCommand}" Width="50" Height="30" Background="#1A1A24" Foreground="#FF8000" BorderBrush="#FF8000" BorderThickness="1,0,1,0" CornerRadius="0" HorizontalAlignment="Center"/>
                        <Button Content="▼" Command="{x:Bind ViewModel.InversionDownCommand}" Width="50" Height="30" Background="#1A1A24" Foreground="#FF8000" BorderBrush="#FF8000" BorderThickness="1" CornerRadius="0 0 4 4" HorizontalAlignment="Center"/>
                        <TextBlock Text="{x:Bind ViewModel.InversionDisplay, Mode=OneWay}" Foreground="#FF8000" HorizontalAlignment="Center" Margin="0,2,0,0" FontSize="12" />
                    </StackPanel>

                </StackPanel>
            </Grid>
        </Border>

    </Grid>
</Page>
